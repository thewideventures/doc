# Copy to .env and fill in real values. Never commit .env.
# REQUIRED IN PRODUCTION (NODE_ENV=production refuses to start without them) are marked [prod-required].
# In development, missing secrets are replaced by derived DEV-ONLY values and a loud warning is printed.
# Generate secrets with:  openssl rand -hex 32

# ======================= Core =======================
PORT=5055
NODE_ENV=development
# [prod-required]
MONGODB_URI=mongodb://127.0.0.1:27017/findadoc

# ======================= Sessions (phase 3) =======================
# [prod-required] >= 32 random chars each, and they must differ. Changing them signs everyone out.
USER_JWT_SECRET=
ADMIN_JWT_SECRET=
# Legacy (phase 1/2). Development only: seeds the derived dev secrets above so dev sessions survive restarts.
# Not used for signing in production.
ADMIN_SECRET_KEY=

# ======================= Admin =======================
# [prod-required]
ADMIN_USERNAME=admin@example.com
# [prod-required: one of the two] Preferred: bcrypt hash from `npm run admin:hash` (keep the single quotes).
ADMIN_PASSWORD_HASH=
# Legacy plaintext fallback (prints a warning; min 12 chars in production). Remove once ADMIN_PASSWORD_HASH is set.
ADMIN_PASSWORD=
# Optional but strongly recommended: base32 TOTP secret from `npm run admin:totp` (enables 2FA on admin login)
ADMIN_TOTP_SECRET=
# Lockout after N failed admin logins, for M minutes (defaults 5 / 15)
ADMIN_MAX_FAILED_LOGINS=5
ADMIN_LOCK_MINUTES=15

# ======================= OTP / SMS =======================
# [prod-required] msg91 | twilio   (console = development only: prints the OTP in the server log)
SMS_PROVIDER=
# MSG91 Flow API: DLT-approved OTP template with an otp variable
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Template variable name holding the code (default: otp)
MSG91_OTP_VAR=otp
# Twilio Messaging
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Fixed demo OTP 123456 for every number. Development only — production refuses to start with true.
# Unset + no SMS_PROVIDER in development => demo mode with a warning. Set false to force real SMS in dev.
OTP_DEMO_MODE=

# ======================= Payments (Razorpay) =======================
# razorpay | mock | disabled. Empty => razorpay when both keys are set, otherwise disabled
# (paid bookings / subscriptions answer 503 "Payments not configured").
# mock = development only (fake checkout, no money); production refuses to start with it.
PAYMENTS_MODE=
# Dashboard > Account & Settings > API Keys (Test mode gives rzp_test_… keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# [prod-required when Razorpay is on] Secret you type when creating the webhook
# (URL https://<your-domain>/api/payments/razorpay/webhook)
RAZORPAY_WEBHOOK_SECRET=

# ======================= HTTP =======================
# [prod-required] Comma-separated https origins of the site (no "*"). Dev origins localhost:3000/5173/5055 are always allowed in dev.
CORS_ORIGINS=
# Reverse proxy hops to trust for client IP (true = 1 hop; never trust everything). false when exposed directly.
TRUST_PROXY=false
# Secure cookies (default: true in production). Set false only for plain-http local testing of a prod build.
COOKIE_SECURE=
# Serve the built SPA from Express (default: true in production)
SERVE_DIST=
# Global API limiter: requests per IP per 15 minutes (default 1500)
RATE_LIMIT_GLOBAL=1500

# ======================= GST / invoicing defaults =======================
# These only seed the Settings document on first start; after that, edit them in Admin > Settings.
BUSINESS_NAME=FindADoc
# 15-character GSTIN of the platform (leave blank if not registered yet)
BUSINESS_GSTIN=
# 2-digit GST state code of the supplier (32 = Kerala). Same-state customers get CGST+SGST; others get IGST.
BUSINESS_STATE_CODE=32
GST_RATE=18
DEFAULT_SAC_CODE=998399
INVOICE_PREFIX=FAD

# ======================= Uploads =======================
STORAGE_DRIVER=local
UPLOAD_DIR=
UPLOAD_MAX_IMAGE_MB=3
UPLOAD_MAX_DOC_MB=8

# ======================= Phase 4: reminders (WhatsApp / SMS) — all optional =======================
# Unset in dev = messages printed to the server console. Production: meta | gupshup | msg91 | disabled (console is refused).
WHATSAPP_PROVIDER=
# Meta WhatsApp Cloud API
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_API_VERSION=v21.0
# Gupshup
GUPSHUP_API_KEY=
GUPSHUP_SOURCE=
GUPSHUP_APP_NAME=
# MSG91 WhatsApp (reuses MSG91_AUTH_KEY)
MSG91_WA_NUMBER=
# JSON map of message kind -> approved template name, e.g. {"reminder_24h":"fad_reminder_24h","reminder_2h":"fad_reminder_2h"}
WHATSAPP_TEMPLATES=
# SMS reminders via SMS_PROVIDER (off unless true). With msg91 a DLT template with a ##message## variable is required.
REMINDER_SMS=
MSG91_REMINDER_TEMPLATE_ID=

# ======================= Phase 4: signed links, scheduler =======================
# Public base URL used in reminder links (https in production). Defaults to the first CORS_ORIGINS entry.
APP_BASE_URL=
# >=32 random chars (openssl rand -hex 32). Unset = derived from USER_JWT_SECRET.
BOOKING_LINK_SECRET=
# node-cron expression for reminders / waitlist expiry / deletion sweep (default every minute)
SCHEDULER_CRON=
# Set to false on every instance except one
SCHEDULER_ENABLED=

# ======================= Phase 4: ABHA / ABDM (optional, never mandatory) =======================
# disabled (default) | sandbox (needs ABDM_CLIENT_ID/SECRET) | mock (dev only, refused in production)
ABHA_PROVIDER=
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_BASE_URL=https://dev.abdm.gov.in
ABHA_BASE_URL=https://abhasbx.abdm.gov.in
# ABDM RSA public key (PEM, \n for newlines) used to encrypt OTPs
ABDM_PUBLIC_KEY=

# ======================= Phase 4: DPDP Act =======================
# Shown on the grievance page (warning in production when name/email are empty)
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=
GRIEVANCE_OFFICER_PHONE=
GRIEVANCE_OFFICER_ADDRESS=
# Days between a deletion request and anonymisation (0-90; default 30 via admin Settings)
DELETION_GRACE_DAYS=

# ======================= Client (Vite, baked in at build time) =======================
# Empty = Leaflet + OpenStreetMap + Nominatim fallback. When set, the CSP also allows the Google Maps hosts.
VITE_GOOGLE_MAPS_API_KEY=

# ======================= Dev only =======================
# Port for `npm run dev:memory-db` (throwaway in-memory MongoDB)
MEMORY_MONGO_PORT=27999
